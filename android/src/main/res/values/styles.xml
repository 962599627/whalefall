<resources>
  <color name="window_background">#0B1220</color>
  <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">#FF8FB1</item>
    <item name="android:windowActionModeOverlay">true</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowBackground">@color/window_background</item>
    <item name="android:windowLightStatusBar">false</item>
    <!-- 1.7.5：主主题也指向插件弹窗样式，覆盖插件用 Activity theme 建 Dialog 的情况 -->
    <item name="android:alertDialogTheme">@style/PluginAlertDialog</item>
    <item name="android:dialogTheme">@style/PluginAlertDialog</item>
    <item name="android:colorPrimary">#FF8FB1</item>
    <item name="android:colorBackground">#141C2A</item>
    <item name="android:colorForeground">#F5F7FC</item>
    <item name="android:textColorPrimary">#F5F7FC</item>
    <item name="android:textColorSecondary">#A9B7D0</item>
    <item name="android:textColorTertiary">#8D9CB6</item>
  </style>

  <!-- 源插件（CSP jar）原生 AlertDialog 的主题：只改外观，不改插件功能。 -->
  <style name="PluginDialogButton" parent="android:style/Widget.Material.Button">
    <item name="android:background">@drawable/plugin_dialog_bg</item>
    <item name="android:textColor">#F5F7FC</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:minHeight">42dp</item>
    <item name="android:paddingLeft">16dp</item>
    <item name="android:paddingRight">16dp</item>
  </style>

  <style name="PluginAlertDialog" parent="android:style/Theme.Material.Dialog.Alert">
    <item name="android:windowBackground">@drawable/plugin_dialog_bg</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowIsFloating">true</item>
    <item name="android:windowMinWidthMajor">84%</item>
    <item name="android:windowMinWidthMinor">84%</item>
    <item name="android:colorAccent">#FF8FB1</item>
    <item name="android:colorBackground">#141C2A</item>
    <item name="android:colorForeground">#F5F7FC</item>
    <item name="android:colorPrimary">#FF8FB1</item>
    <item name="android:textColorPrimary">#F5F7FC</item>
    <item name="android:textColorSecondary">#A9B7D0</item>
    <item name="android:textColorTertiary">#8D9CB6</item>
    <item name="android:buttonBarButtonStyle">@style/PluginDialogButton</item>
    <item name="android:buttonBarNegativeButtonStyle">@style/PluginDialogButton</item>
    <item name="android:buttonBarPositiveButtonStyle">@style/PluginDialogButton</item>
    <item name="android:buttonBarNeutralButtonStyle">@style/PluginDialogButton</item>
  </style>

  <style name="PluginDialogTheme" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:alertDialogTheme">@style/PluginAlertDialog</item>
    <item name="android:dialogTheme">@style/PluginAlertDialog</item>
    <item name="android:windowBackground">@drawable/plugin_dialog_bg</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:colorAccent">#FF8FB1</item>
    <item name="android:colorBackground">#141C2A</item>
    <item name="android:colorForeground">#F5F7FC</item>
    <item name="android:textColorPrimary">#F5F7FC</item>
    <item name="android:textColorSecondary">#A9B7D0</item>
    <item name="android:textColorTertiary">#8D9CB6</item>
  </style>
</resources>
